<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VitaPresence.App</RootNamespace>
    <AssemblyName>VitaPresence</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VitaPresence.Core\VitaPresence.Core.csproj" />
    <ProjectReference Include="..\VitaPresence.Discord\VitaPresence.Discord.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Attention.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CopyDiscordHelper" AfterTargets="Build">
    <PropertyGroup>
      <_HelperRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)\</_HelperRid>
      <_HelperDir>$(MSBuildThisFileDirectory)..\VitaPresence.Discord\bin\$(Configuration)\net10.0\$(_HelperRid)</_HelperDir>
    </PropertyGroup>
    <ItemGroup>
      <_HelperFile Include="$(_HelperDir)vitapresence-discord.exe" />
      <_HelperFile Include="$(_HelperDir)vitapresence-discord.dll" />
      <_HelperFile Include="$(_HelperDir)vitapresence-discord.runtimeconfig.json" />
      <_HelperFile Include="$(_HelperDir)vitapresence-discord.deps.json" />
      <_HelperFile Include="$(_HelperDir)VitaPresence.Core.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_HelperFile)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(_HelperFile.Identity)')" />
  </Target>
</Project>
